;
; Raspberry Pi RNDIS Gadget Driver Installation
; For Windows 7/8/10/11
;
; This INF file tells Windows to use its built-in RNDIS driver
; for the Raspberry Pi USB Ethernet gadget
;

[Version]
Signature           = "$Windows NT$"
Class               = Net
ClassGUID           = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider            = %ProviderName%
DriverVer           = 10/22/2024,1.0.0.0
CatalogFile         = rpi_rndis.cat

[Manufacturer]
%ProviderName%      = RaspberryPi,NTx86,NTamd64,NTarm,NTarm64

[RaspberryPi.NTx86]
%RndisDevice%       = RNDIS.NT.5.1, USB\VID_0525&PID_A4A2

[RaspberryPi.NTamd64]
%RndisDevice%       = RNDIS.NT.5.1, USB\VID_0525&PID_A4A2

[RaspberryPi.NTarm]
%RndisDevice%       = RNDIS.NT.5.1, USB\VID_0525&PID_A4A2

[RaspberryPi.NTarm64]
%RndisDevice%       = RNDIS.NT.5.1, USB\VID_0525&PID_A4A2

[RNDIS.NT.5.1]
Characteristics     = 0x84   ; NCF_PHYSICAL + NCF_HAS_UI
BusType             = 15
include             = netrndis.inf
needs               = Usb_Rndis.ndi
AddReg              = Rndis_AddReg_Vista

[RNDIS.NT.5.1.Services]
include             = netrndis.inf
needs               = Usb_Rndis.ndi.Services

[Rndis_AddReg_Vista]
HKR, ,                  RSSConfiguration,         0, "2"
HKR, Ndi,               Service,                  0, "usb8023"
HKR, Ndi\Interfaces,    UpperRange,               0, "ndis5"
HKR, Ndi\Interfaces,    LowerRange,               0, "ethernet"

[Strings]
ProviderName        = "Raspberry Pi Foundation"
RndisDevice         = "Raspberry Pi USB Ethernet/RNDIS Gadget"



